                          "the page's 總額), 含稅項及費用; price_per_night = price_total / nights. Only rates "
                          "the site shows for this party are listed; hidden_rates were dropped by the site for "
                          "not fitting the party.",
           "url": hotel_url(hid, args)}

    def human():
        L = [f"{out.get('name') or hid}  ★{out.get('stars') or '?'}  {out.get('rating') or '?'}/10 "
             f"({out.get('reviews') or 0} reviews)",
             f"{out.get('address') or ''}  [{out.get('area') or ''}]",
             f"check-in {out.get('checkin_time') or '?'}  check-out {out.get('checkout_time') or '?'}  "
             f"saved={out.get('saved')}",
             "amenities: " + (", ".join((out.get("amenities") or [])[:12]) or "-")]
