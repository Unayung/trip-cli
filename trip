FAV_BTN = "div[class*=collectButton_hotelOverview_collectBtn]"


def cmd_saved(args):
    st = need_session()
    cl = Client(argparse.Namespace(via="http", debug=args.debug, currency=args.currency), st)
    if args.action == "list":
        fav = favourites(cl)
        return emit(ok(fav), args.json, lambda: (f"{fav['total']} saved hotel(s)\n" + table(
            [[i["id"], clip(i["name"], 30), i["area"], i["created"]] for i in fav["items"]],
            ["id", "name", "area", "saved on"])) if fav["items"] else "no saved hotels")
    if not args.ref:
        raise Usage("saved add/rm needs a hotel id or URL")
    hid = str(hotel_id(args.ref))
    before = favourites(cl)
    is_saved = any(i["id"] == hid for i in before["items"])
    want = args.action == "add"
    if is_saved == want:
        return emit(ok({"id": hid, "saved": is_saved, "changed": False}), args.json,
                    f"{hid} is already {'saved' if is_saved else 'not saved'}; nothing to do")
    if not args.yes:
        return emit(ok({"dry_run": True, "id": hid, "action": args.action, "currently_saved": is_saved,
                        "saved_total": before["total"]}), args.json,
                    f"would {args.action} {hid} (currently saved={is_saved}); re-run with --yes")
    d1 = (dt.date.today() + dt.timedelta(days=30)).isoformat()
    d2 = (dt.date.today() + dt.timedelta(days=31)).isoformat()
    url = hotel_url(int(hid), argparse.Namespace(checkin=d1, checkout=d2, adults=2, children=[], rooms=1,
                                                 currency=cl.currency))
    with Browser(url, debug=args.debug) as br:
        br.p.call("Emulation.setFocusEmulationEnabled", enabled=True)  # our own tab only; lets it hydrate
        state_js = ("(()=>{const b=document.querySelector(%s);const i=b&&b.querySelector('i');"
                    "return !b?'none':(/collectIcon_selected/.test(i&&i.className)?'on':'off')})()" % json.dumps(FAV_BTN))
        ui = None
        for _ in range(15):
            ui = br.eval(state_js)
            if ui in ("on", "off"):
                break
            time.sleep(1)
        if ui not in ("on", "off"):
            raise ApiError("could not find the 收藏 button on the hotel page")
        clicked_ui = None
        if (ui == "on") != want:
            time.sleep(5)  # measured: an immediate click on a just-loaded tab did nothing
            br.eval("document.querySelector(%s).click()" % json.dumps(FAV_BTN))  # exactly one click
            for _ in range(10):
                time.sleep(1)
                clicked_ui = br.eval(state_js)
                if (clicked_ui == "on") == want:
                    break
    after = None
    for _ in range(8):
        time.sleep(2)
        after = favourites(cl)
        if any(i["id"] == hid for i in after["items"]) == want:
            break
    now = any(i["id"] == hid for i in after["items"])
    if now != want:
        raise ApiError(f"clicked 收藏 once but the server list still says saved={now} (button now "
                       f"{clicked_ui}) - check `trip saved list`", {"saved_total": after["total"]})
    return emit(ok({"id": hid, "saved": now, "changed": True, "verified": "GetMyFavorites re-read",
                    "saved_total": after["total"]}), args.json,
                f"{hid} is now {'saved' if now else 'not saved'} (verified by re-reading the list; {after['total']} saved)")


# ------------------------------------------------------------------ parser
class Parser(argparse.ArgumentParser):
    def error(self, message):
        as_json = "--json" in sys.argv
        emit(err(f"{self.prog}: {message}", EX_USAGE), as_json)
        if not as_json:
            self.print_usage(sys.stderr)
        sys.exit(EX_USAGE)


def csv_ints(s):
    try:
        return [int(x) for x in str(s).split(",") if x.strip()]
    except ValueError:
        raise argparse.ArgumentTypeError(f"expected comma-separated numbers, got {s!r}")


def add_party(p):
    p.add_argument("--checkin", required=True)
    p.add_argument("--checkout", required=True)
    p.add_argument("--adults", type=int, default=2)
    p.add_argument("--children", type=csv_ints, default=[], help="ages, comma separated, e.g. 7,4")
    p.add_argument("--rooms", type=int, default=1)


def build_parser():
    p = Parser(prog="trip", description="Trip.com Taiwan (tw.trip.com) hotels from the shell (no booking).")
    p.add_argument("--version", action="version", version=VERSION)
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--json", action="store_true", help="stable {ok, data|error} envelope")
    common.add_argument("--debug", action="store_true", help="dump requests to stderr")
    common.add_argument("--via", choices=["auto", "http", "browser"], default="auto",
                        help="http = plain HTTPS with the saved session (default path); browser = fetch inside a "
                             "background Edge tab; auto = http, browser only on an empty anti-bot reply")
    common.add_argument("--cdp", default=None, help=f"CDP endpoint (default {CDP})")
    common.add_argument("--currency", default="TWD", help="currency (default TWD; only TWD measured live)")
    sub = p.add_subparsers(dest="cmd", required=True, parser_class=Parser)

    sub.add_parser("doctor", parents=[common], help="transport, API reachability, login state").set_defaults(fn=cmd_doctor)

    sg = sub.add_parser("suggest", parents=[common], help="typeahead / destination lookup")
    sg.add_argument("text")
    sg.add_argument("--limit", type=int, default=10)
    sg.set_defaults(fn=cmd_suggest)

    s = sub.add_parser("search", parents=[common], help="search hotels (prices = stay total incl. taxes)")
    s.add_argument("destination", help="free text (resolved via typeahead) or a numeric Trip.com city id")
    add_party(s)
    s.add_argument("--country-id", type=int, default=0, help="only with a numeric city id")
    s.add_argument("--sort", choices=list(SORTS))
    s.add_argument("--page", type=int, default=1)
    s.add_argument("--limit", type=int, default=20)
    s.add_argument("--pool", type=int, default=100, help="price sorts: hotels read before re-sorting (default 100)")
    s.add_argument("--min", type=float, help="min price per night (TWD, stay total / nights)")
    s.add_argument("--max", type=float, help="max price per night (TWD, stay total / nights)")
    s.add_argument("--stars", type=csv_ints, default=[], help="e.g. 3,4")
    s.add_argument("--verify", action="store_true",
                   help="re-check every shown row on the hotel's room list (1 extra call per row)")
    s.add_argument("--free-cancel", action="store_true")
    s.add_argument("--breakfast", action="store_true")
    s.set_defaults(fn=cmd_search)

    h = sub.add_parser("hotel", aliases=["rooms"], parents=[common], help="rooms/rates for one hotel")
    h.add_argument("ref", help="hotel id or tw.trip.com hotel URL")
    add_party(h)
    h.set_defaults(fn=cmd_hotel)

    pc = sub.add_parser("price", parents=[common], help="lowest total price for several hotels")
    pc.add_argument("refs", nargs="+")
    add_party(pc)
    pc.set_defaults(fn=cmd_price)

    lg = sub.add_parser("login", parents=[common], help="save a signed-in Trip.com session")
    g = lg.add_mutually_exclusive_group()
    g.add_argument("--from-browser", action="store_true", help="(default) copy the session from Edge on CDP")
    g.add_argument("--from-clipboard", action="store_true", help="Cookie header from the clipboard")
    g.add_argument("--cookie-stdin", action="store_true", help="paste/pipe a Cookie header")
    lg.add_argument("--wait", type=int, default=300, help="seconds to wait for you to sign in")
    lg.add_argument("--keyring", action="store_true", help="store cookies in the OS keyring")
    lg.set_defaults(fn=cmd_login)
    sub.add_parser("logout", parents=[common], help="delete the saved session").set_defaults(fn=cmd_logout)
    sub.add_parser("whoami", parents=[common], help="verify the session live (email, member tier)"
                   ).set_defaults(fn=cmd_whoami)

    t = sub.add_parser("trips", parents=[common], help="read-only list of your orders/bookings")
    t.add_argument("--status", default="All", choices=["All", "NotTravel", "AwaitPay", "AwaitReview"])
    t.add_argument("--limit", type=int, default=20)
    t.set_defaults(fn=cmd_trips)

    sv = sub.add_parser("saved", parents=[common], help="saved hotels (收藏) list/add/rm; no booking")
    sv.add_argument("action", choices=["list", "add", "rm"])
    sv.add_argument("ref", nargs="?", help="add/rm: hotel id or URL")
    sv.add_argument("--yes", action="store_true", help="really write; without it only preview")
    sv.set_defaults(fn=cmd_saved)

    r = sub.add_parser("raw", parents=[common], help="GET passthrough for debugging (JSON out)")
    r.add_argument("path")
    r.set_defaults(fn=cmd_raw)
    return p


def main(argv=None):
    args = build_parser().parse_args(argv)
    if getattr(args, "cdp", None):
        _set_cdp(args.cdp)
    try:
        return args.fn(args)
    except Auth as e:
        return emit(err(str(e), EX_AUTH), args.json)
    except Net as e:
        return emit(err(str(e), EX_NET), args.json)
    except Usage as e:
        return emit(err(str(e), EX_USAGE), args.json)
    except ApiError as e:
        return emit(err(str(e), EX_ERR, **(e.detail or {})), args.json)
    except BrokenPipeError:
        return EX_OK
    except KeyboardInterrupt:
        return EX_ERR


if __name__ == "__main__":
    sys.exit(main())
