def tag_titles(tags, key):
    return [t.get("tagTitle") or "" for t in (tags or {}).get(key) or []]


def parse_card(h, nights, args, currency):
    hi = h.get("hotelInfo") or {}
    s = hi.get("summary") or {}
    ad = hi.get("advertiseInfo") or {}
    ri = (h.get("roomInfo") or [{}])[0] or {}
    pi = ri.get("priceInfo") or {}
    tags = ri.get("roomTags") or {}
    adv, promo = tag_titles(tags, "advantageTags"), tag_titles(tags, "promotionTags")
    expl = pi.get("priceExplanation") or ""
    total = pi.get("price") if isinstance(pi.get("price"), (int, float)) and pi.get("price") > 0 else None
    pos = hi.get("positionInfo") or {}
    cm = hi.get("commentInfo") or {}
    star = hi.get("hotelStar") or {}
    hid = str(s.get("hotelId") or "")
    return {
        "id": hid,
        "name": (hi.get("nameInfo") or {}).get("name"),
        "stars": star.get("star"),
        "category": (hi.get("hotelCategory") or {}).get("categoryName"),
        "rating": num(cm.get("commentScore")),
        "reviews": int(num(cm.get("commenterNumber")) or 0) or None,
        "area": " / ".join(pos.get("zoneNames") or []) or None,
        "distance": pos.get("positionDesc") or None,
        "price_total": total,
        "price_per_night": round(total / nights) if total else None,
        "price": total,
        "currency": pi.get("currency") or currency,
        "units": untag(expl.split("含稅")[0]).strip(" ×") or None,
        "taxes_included": "含稅" in expl,
        "extra_charges_possible": "可能額外收費" in expl,
        "room": (ri.get("summary") or {}).get("saleRoomName"),
        "free_cancellation": any("免費取消" in t for t in adv),
        "breakfast": any("早餐" in t for t in adv),
        "member_deal": next((t for t in promo if "會員" in t), None),
        "sponsored": bool(ad.get("isAdHotel") or ad.get("isAdSolt")),
        "available": total is not None,
        "url": hotel_url(hid, args),
    }


def search_body(cl, args, dest, sort, page, shown, session_id, size):
    f = [{"filterId": "29|1", "type": "29", "value": f"{args.rooms}|{args.adults}"}]
    for a in args.children:
        f.append({"filterId": f"29|2|{a}", "type": "29", "value": f"2|{a}"})
    f.append({"filterId": "80|1|0", "type": "80", "value": "1", "subType": "2"})
    f.append({"filterId": sort, "type": "17", "value": sort.split("|")[1], "subType": "2"})
    if dest["filter"]:
        f.append(dest["filter"])
    for s in args.stars or []:
        f.append({"filterId": f"16|{s}", "type": "16", "value": str(s), "subType": "2"})
    if args.free_cancel:
        f.append({"filterId": "23|10", "type": "23", "value": "10"})
    if args.breakfast:
        f.append({"filterId": "5|1", "type": "5", "value": "1", "subType": "2"})
    return {"date": {"dateType": 1, "dateInfo": {"checkInDate": args.checkin.replace("-", ""),
                                                  "checkOutDate": args.checkout.replace("-", "")}},
            "destination": {"type": 1, "geo": {"cityId": dest["city_id"], "countryId": dest["country_id"]},
                            "keyword": {"word": ""}},
            "extraFilter": {"childInfoItems": [{"age": a} for a in args.children], "sessionId": session_id},
            "filters": f, "roomQuantity": args.rooms,
            "paging": {"pageIndex": page, "pageSize": size, "pageCode": "10320668148"},
            "hotelIdFilter": {"hotelAldyShown": list(shown)}, "head": cl.head()}


SITE_PAGE = 20
MAX_SITE_PAGES = 25


def cmd_search(args):
    if args.limit < 1 or args.page < 1:
        raise Usage("--limit and --page must be >= 1")
    _, _, nights = stay(args)
    sort_key = args.sort or "recommended"
    price_sort = sort_key in ("price", "price-desc")
    offset, need = (args.page - 1) * args.limit, args.page * args.limit
    # Trip.com's 最低價/最高價 order is only sorted within each of its pages (measured: page 4 held
    # NT$4,430 while page 1 started at 4,497), so price sorts read a fixed pool of its first
    # --pool hotels, re-sort that by total and serve --page windows from the same pool.
    want = max(args.pool, need) if price_sort else need
    dropped = {"sponsored": 0, "duplicate": 0, "no_price": 0, "price_filter": 0}
    with Client(args) as cl:
        dest = resolve_destination(cl, args.destination, args.country_id)
        # same query -> same session id, so page 1 and page 2 calls see the same site pool
        sid = hashlib.md5(json.dumps([dest["city_id"], dest.get("filter_id"), args.checkin, args.checkout,
                                      args.adults, args.children, args.rooms, sort_key, args.stars,
                                      args.free_cancel, args.breakfast]).encode()).hexdigest()
        pool, seen, shown = [], set(), []
        total_count, site_pages = None, 0
        for page in range(1, MAX_SITE_PAGES + 1):
            d = cl.soa(SOA + "/34951/fetchHotelList",
                       search_body(cl, args, dest, SORTS[sort_key], page, shown, sid, SITE_PAGE))
            data = d.get("data") or {}
            info = data.get("hotelListAddtionInfo") or {}
            total_count = info.get("hotelTotalCount", total_count)
            cards = data.get("hotelList") or []
            site_pages += 1
            for h in cards:
                r = parse_card(h, nights, args, cl.currency)
                if r["id"] and r["id"] not in shown:
                    shown.append(r["id"])
                if r["sponsored"]:
                    dropped["sponsored"] += 1
                    continue
                if r["id"] in seen:
                    dropped["duplicate"] += 1
                    continue
                seen.add(r["id"])
                if not r["available"]:
                    dropped["no_price"] += 1
                    continue
                if (args.min is not None and r["price_per_night"] < args.min) or \
                        (args.max is not None and r["price_per_night"] > args.max):
                    dropped["price_filter"] += 1
                    continue
                pool.append(r)
            if len(pool) >= want or not cards or info.get("isLastPage"):
                break
        if price_sort:
            pool.sort(key=lambda r: (r["price_total"], r["id"]), reverse=(sort_key == "price-desc"))
        items = pool[offset:need]
        if args.verify:  # re-check each shown row against the hotel's own room list (one call per row)
            for r in items:
                try:
                    c = parse_rooms(cl.soa(SOA + "/33269/getHotelRoomListOversea", rooms_body(cl, int(r["id"]), args)),
                                    nights)["cheapest"]
                except (ApiError, Blocked) as e:
                    r["verified"] = {"error": str(e)}
                    continue
                r["verified"] = {"total": c and c["price_total"], "room": c and c["room"], "bookable": bool(c),
                                 "matches_search": bool(c) and c["price_total"] == r["price_total"]}
    out = {"destination": args.destination, "matched": dest["name"], "kind": dest["kind"],
           "city_id": dest["city_id"], "filter_id": dest.get("filter_id"), "checkin": args.checkin,
           "checkout": args.checkout, "nights": nights, "adults": args.adults, "children": args.children,
           "rooms": args.rooms, "sort": sort_key, "page": args.page, "count": len(items),
           "matched_total": total_count, "site_pages_read": site_pages, "dropped": dropped,
           "price_basis": "price_total = Trip.com's stay total for the whole party (all rooms, all nights), "
                          "labelled 含稅項及費用 (taxes and fees included) by the site; price_per_night = "
                          "price_total / nights. Sorting uses price_total only. extra_charges_possible=true "
                          "means the site adds 可能額外收費 (possible extra charges at the property). "
                          "units shows what the price buys (e.g. '3 張床 × 3晚' = dorm beds).",
           "pool_size": len(pool),
           "paging_note": None if not price_sort else
           f"price sorts rank the first {len(pool)} priced hotels of Trip.com's own price order, re-sorted "
           "by price_total; --page is a window over that pool (Trip.com's order is not monotonic across its "
           "pages, so a cheaper hotel can exist beyond the pool; raise --pool to look further).",
           "items": items}
    return emit(ok(out), args.json, lambda: (
        f"matched: {dest['name']} [{dest['kind']}] city {dest['city_id']}, {total_count} hotels, "
        f"{nights} night(s), page {args.page}; prices = stay total incl. taxes/fees\n"
        + table([[r["id"], clip(r["name"], 30), r["stars"] or "", f"{r['rating'] or ''}({r['reviews'] or 0})",
                  money(r["price_total"], cl.currency), money(r["price_per_night"], cl.currency),
                  clip(r["room"], 16), clip(r["units"], 12), ("免取消 " if r["free_cancellation"] else "") + ("含早 " if r["breakfast"] else "")
                  + ("會員 " if r["member_deal"] else "") + ("+費 " if r["extra_charges_possible"] else ""),
                  clip(r["distance"] or r["area"], 22)]
                 + ([("ok" if r["verified"].get("matches_search") else
                      "SOLD OUT" if r["verified"].get("bookable") is False else
                      money(r["verified"].get("total"), cl.currency) or "ERR")] if args.verify else [])
                 for r in items],
                ["id", "name", "★", "rating", "total", "/night", "room", "units", "flags", "where"]
                + (["verified"] if args.verify else []))
        + f"\ndropped: {dropped}"))


