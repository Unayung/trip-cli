# ---------------------------------------------------------------- envelope
def ok(data):
    return {"ok": True, "data": data}


def err(msg, code=EX_ERR, **detail):
    return {"ok": False, "error": {"message": msg, "code": code, "detail": detail or None}}


def emit(payload, as_json, human=None):
    if as_json:
        print(json.dumps(payload, ensure_ascii=False, indent=2))
    elif payload.get("ok"):
        print(human() if callable(human) else
              (human if human is not None else json.dumps(payload["data"], ensure_ascii=False, indent=2)))
    else:
        print(payload["error"]["message"], file=sys.stderr)
    return EX_OK if payload.get("ok") else payload["error"]["code"]


def _w(text):
    return sum(2 if unicodedata.east_asian_width(c) in "WF" else 1 for c in str(text))


def table(rows, headers):
    if not rows:
        return "(no rows)"
    cols = list(zip(*([headers] + rows)))
    widths = [max(_w("" if c is None else c) for c in col) for col in cols]
    pad = lambda t, w: str(t) + " " * max(0, w - _w(t))  # noqa: E731
    out = ["  ".join(pad(h, w) for h, w in zip(headers, widths)).rstrip(),
           "  ".join("-" * w for w in widths)]
    for r in rows:
        out.append("  ".join(pad("" if c is None else c, w) for c, w in zip(r, widths)).rstrip())
    return "\n".join(out)


def clip(text, n):
    text = (text or "").replace("\n", " ").strip()
    if _w(text) <= n:
        return text
    out = ""
    for c in text:
        if _w(out + c) > n - 1:
            break
        out += c
    return out + "…"


def money(v, currency="TWD"):
    if v is None:
        return ""
    sym = "NT$" if currency == "TWD" else currency + " "
    return f"{sym}{v:,.0f}"


def num(text):
    m = re.search(r"-?[\d,]+(?:\.\d+)?", str(text or ""))
    return float(m.group(0).replace(",", "")) if m else None


def untag(s):
    return re.sub(r"\s+", " ", re.sub(r"\{/?\d\}", "", s or "")).strip()


# -------------------------------------------------------- CDP (stdlib ws)
class WS:
    def __init__(self, url, timeout=60):
        if not url.startswith("ws://"):
            raise Net(f"unsupported websocket url {url}")
        hostport, path = url[5:].split("/", 1)
        host, port = hostport.rsplit(":", 1)
        try:
            self.s = socket.create_connection((host, int(port)), timeout=timeout)
        except OSError as e:
            raise Net(f"cannot reach browser at {hostport}: {e}")
        key = base64.b64encode(os.urandom(16)).decode()
        self.s.sendall((f"GET /{path} HTTP/1.1\r\nHost: {hostport}\r\n"
                        "Upgrade: websocket\r\nConnection: Upgrade\r\n"
                        f"Sec-WebSocket-Key: {key}\r\nSec-WebSocket-Version: 13\r\n\r\n").encode())
        buf = b""
        while b"\r\n\r\n" not in buf:
            chunk = self.s.recv(4096)
            if not chunk:
                raise Net("websocket handshake closed")
            buf += chunk
        if b" 101 " not in buf.split(b"\r\n")[0]:
            raise Net("websocket handshake refused (start Edge with --remote-allow-origins='*')")
        self.rest = buf.split(b"\r\n\r\n", 1)[1]
        self.n = 0

    def _recv(self, n):
        while len(self.rest) < n:
            chunk = self.s.recv(65536)
            if not chunk:
                raise Net("browser closed the connection")
            self.rest += chunk
        out, self.rest = self.rest[:n], self.rest[n:]
        return out

    def _send(self, obj):
        data = json.dumps(obj).encode()
        hdr = bytearray([0x81])
        n = len(data)
        if n < 126:
            hdr.append(0x80 | n)
        elif n < 65536:
            hdr.append(0x80 | 126)
            hdr += struct.pack(">H", n)
        else:
            hdr.append(0x80 | 127)
            hdr += struct.pack(">Q", n)
        mask = os.urandom(4)
        hdr += mask
        self.s.sendall(bytes(hdr) + bytes(b ^ mask[i % 4] for i, b in enumerate(data)))

    def _recv_msg(self):
        msg = b""
        while True:
            b0, b1 = self._recv(2)
            n = b1 & 0x7F
            if n == 126:
                n = struct.unpack(">H", self._recv(2))[0]
            elif n == 127:
                n = struct.unpack(">Q", self._recv(8))[0]
            payload = self._recv(n)
            op = b0 & 0x0F
            if op == 8:
                raise Net("browser closed the websocket")
            if op in (9, 10):
                continue
            msg += payload
            if b0 & 0x80:
                return json.loads(msg)

    def call(self, method, **params):
        self.n += 1
        i = self.n
        self._send({"id": i, "method": method, "params": params})
        while True:
            m = self._recv_msg()
            if m.get("id") == i:
                if "error" in m:
                    raise Net(f"{method}: {m['error'].get('message')}")
                return m["result"]

    def close(self):
        try:
            self.s.close()
        except OSError:
            pass


def _http_json(path):
    try:
        with urllib.request.urlopen(CDP + path, timeout=5) as r:
            return json.loads(r.read())
    except OSError as e:
        raise Net(f"no browser on {CDP} ({e}). Edge must already run with --remote-debugging-port=9222")


def _set_cdp(cdp):
    global CDP
    if cdp:
        CDP = cdp


def _keep_cookie(c):
    return (c.get("domain") or "").lstrip(".") in KEEP_HOSTS


def edge_cookies():
    """Trip.com cookies of the CDP browser (browser-level read, no tab)."""
    ver = _http_json("/json/version")
    b = WS(ver["webSocketDebuggerUrl"])
    try:
        cks = b.call("Storage.getCookies")["cookies"]
    finally:
        b.close()
    keep = [{"name": c["name"], "value": c["value"], "domain": c["domain"]} for c in cks if _keep_cookie(c)]
    return keep, ver.get("User-Agent")


class Browser:
    """One background tab of the user's Edge, closed on exit, never focused.
    Snapshots the shared .trip.com locale cookies and restores them on close."""

    def __init__(self, url=ORIGIN + "/robots.txt", debug=False):
        self.debug = debug
        self._url = url
        self.ver = _http_json("/json/version")
        self.b = WS(self.ver["webSocketDebuggerUrl"])
        self.snap = [c for c in self.b.call("Storage.getCookies")["cookies"]
                     if c.get("domain") == ".trip.com" and c["name"] in LOCALE_COOKIES]
        self.tid = self.b.call("Target.createTarget", url=url, background=True)["targetId"]
        try:
            tgt = next(x for x in _http_json("/json/list") if x["id"] == self.tid)
            self.p = WS(tgt["webSocketDebuggerUrl"], timeout=90)
            self._wait_ready(urllib.parse.urlparse(url).netloc)
        except BaseException:
            self.close()
            raise

    def __enter__(self):
        return self

    def __exit__(self, *a):
        self.close()

    def _wait_ready(self, host, limit=30):
        t0, retried = time.time(), False
        while time.time() - t0 < limit:
            r = self.eval("location.host + '|' + document.readyState")
            if r and r.startswith(host) and "|loading" not in r:
                return
            if r and r.startswith("chromewebdata") and not retried and time.time() - t0 > 4:
                retried = True
                try:
                    self.p.call("Page.navigate", url=self._url)
                except Net:
                    pass
            time.sleep(0.7)
        raise Blocked(f"{host} did not load in the background tab (bot check?)")

    def eval(self, expr):
        r = self.p.call("Runtime.evaluate", expression=expr, awaitPromise=True, returnByValue=True)
        if r.get("exceptionDetails"):
            raise ApiError("page script failed: " + str(
                r["exceptionDetails"].get("exception", {}).get("description") or r["exceptionDetails"].get("text")))
        return r.get("result", {}).get("value")

    def navigate(self, url):
        self._url = url
        self.p.call("Page.navigate", url=url)
        self._wait_ready(urllib.parse.urlparse(url).netloc)

    def fetch(self, method, url, body=None, headers=None):
        opts = {"method": method, "credentials": "include", "headers": headers or {}}
        if body is not None:
            opts["body"] = body
        js = ("fetch(%s,%s).then(async r=>({http:r.status,text:await r.text()}))" % (json.dumps(url), json.dumps(opts)))
        r = self.eval(js)
        return r["http"], r["text"]

    def close(self):
        # Edge quits when its last page target closes (measured on hotels-cli):
        # if ours is the only page left, blank it instead of closing it.
        try:
            pages = [t for t in self.b.call("Target.getTargets").get("targetInfos", []) if t.get("type") == "page"]
            only = len(pages) <= 1 and any(t.get("targetId") == self.tid for t in pages)
        except Exception:
            only = False
        try:
            if getattr(self, "tid", None):
                if only:
                    self.p.call("Page.navigate", url="about:blank")
                else:
                    self.b.call("Target.closeTarget", targetId=self.tid)
        except Exception:
            pass
        try:  # put the user's locale cookies back exactly as found
            now = {c["name"]: c.get("value") for c in self.b.call("Storage.getCookies")["cookies"]
                   if c.get("domain") == ".trip.com" and c["name"] in LOCALE_COOKIES}
            fix = [{k: c[k] for k in ("name", "value", "domain", "path", "secure", "httpOnly", "sameSite", "expires")
                    if k in c} for c in self.snap if now.get(c["name"]) != c["value"]]
            if fix:
                self.b.call("Storage.setCookies", cookies=fix)
        except Exception:
            pass
        for w in (getattr(self, "p", None), getattr(self, "b", None)):
            if w:
                w.close()


# ------------------------------------------------------------------ state
def _keyring(op, secret=None, acct="default"):
    try:
        if sys.platform == "darwin":
            cmd = {"set": ["security", "add-generic-password", "-U", "-a", acct, "-s", KEYRING_SERVICE, "-w", secret],
                   "get": ["security", "find-generic-password", "-a", acct, "-s", KEYRING_SERVICE, "-w"],
                   "del": ["security", "delete-generic-password", "-a", acct, "-s", KEYRING_SERVICE]}[op]
            r = subprocess.run(cmd, capture_output=True, text=True)
        else:
            base = ["service", KEYRING_SERVICE, "account", acct]
            cmd = {"set": ["secret-tool", "store", "--label=trip-cli"] + base,
                   "get": ["secret-tool", "lookup"] + base,
                   "del": ["secret-tool", "clear"] + base}[op]
            r = subprocess.run(cmd, input=secret if op == "set" else None, capture_output=True, text=True)
    except FileNotFoundError:
        raise Auth("no keyring tool (macOS `security` / Linux `secret-tool`)")
    if op == "get":
        return r.stdout.strip() if r.returncode == 0 else None
    if op == "set" and r.returncode != 0:
        raise Auth("keyring write failed: " + r.stderr.strip())
    return True


def keyring_save(cookies):
    blob = json.dumps(cookies, separators=(",", ":"))
    parts = [blob[i:i + KR_CHUNK] for i in range(0, len(blob), KR_CHUNK)]
    for i, part in enumerate(parts):
        _keyring("set", part, f"default.{i}")
    return len(parts)


def keyring_load(n):
    parts = [_keyring("get", acct=f"default.{i}") for i in range(n or 0)]
    if not n or any(p is None for p in parts):
        raise Auth("saved keyring session is missing - run `trip login --keyring`")
    try:
        return json.loads("".join(parts))
    except ValueError:
        raise Auth("saved keyring session is corrupt - run `trip login --keyring`")


def keyring_clear(n):
    for i in range(max(n or 0, 1)):
        _keyring("del", acct=f"default.{i}")
    _keyring("del")


def clean_cookie(raw):
    raw = (raw or "").strip()
    if raw.lower().startswith("cookie:"):
        raw = raw.split(":", 1)[1].strip()
    pairs = [p.strip() for p in raw.replace("\n", ";").split(";")]
    good_re = re.compile(r"^[!#$%&'*+.^_`|~0-9A-Za-z-]+=[\x21-\x7e]*$")
    good = [p for p in pairs if p and good_re.match(p)]
    if not any(p.startswith("cticket=") and len(p) > 9 for p in good):
        raise Auth("that does not look like a signed-in Trip.com Cookie header (no cticket). DevTools > Network > "
                   "a tw.trip.com request > Request Headers > copy the value of `Cookie`")
    return "; ".join(good)


def header_to_cookies(header):
    return [{"name": p.split("=", 1)[0].strip(), "value": p.split("=", 1)[1].strip(), "domain": ".trip.com"}
            for p in header.split(";") if "=" in p]


def load_state():
    try:
        with open(STATE_FILE, encoding="utf-8") as f:
            st = json.load(f)
    except FileNotFoundError:
        st = {}
    except (OSError, ValueError) as e:
        raise ApiError(f"state file unreadable: {e}")
    if os.environ.get("TRIP_COOKIE"):
        st["cookies"], st["source"] = header_to_cookies(clean_cookie(os.environ["TRIP_COOKIE"])), "env"
    elif st.get("cookie_in_keyring"):
        try:
            st["cookies"] = keyring_load(st.get("keyring_parts"))
        except Auth as e:
            st["cookies"], st["keyring_error"] = [], str(e)
        st["source"] = "keyring"
    elif st.get("cookies"):
        st["source"] = "file"
    return st


def save_state(st):
    os.makedirs(STATE_DIR, mode=0o700, exist_ok=True)
    out = {k: v for k, v in st.items() if k not in ("source", "keyring_error")}
    if out.get("cookie_in_keyring"):
        out.pop("cookies", None)
    tmp = STATE_FILE + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump(out, f, ensure_ascii=False, indent=2)
    os.chmod(tmp, 0o600)
    os.replace(tmp, STATE_FILE)


def signed_in(cookies):
    return any(c["name"] == "cticket" and c.get("value") for c in cookies or [])


def cookie_header(cookies, url, currency):
    host = urllib.parse.urlparse(url).hostname or ""
    vals = {}
    for c in cookies or []:
        d = c.get("domain") or ".trip.com"
        if host == d.lstrip(".") or (d.startswith(".") and host.endswith(d)) or d == "trip.com":
            if d.startswith(".") or c["name"] not in vals:
                vals[c["name"]] = c["value"]
    # Only in our own request: Taiwan site locale, whatever Edge has (measured zh_hk/HKD).
    vals.update(ibulocale="zh_tw", ibulanguage="TW", cookiePricesDisplayed=currency)
    return "; ".join(f"{k}={v}" for k, v in vals.items())


# -------------------------------------------------------------- transport
class Client:
    def __init__(self, args, st=None):
        self.args = args
        self.st = st if st is not None else load_state()
        self.debug = getattr(args, "debug", False)
        self.currency = (getattr(args, "currency", None) or "TWD").upper()
        self.via = getattr(args, "via", "auto")
        self.br = None
        self.ua = os.environ.get("TRIP_UA") or self.st.get("ua") or DEFAULT_UA
        self._calls = 0

    def __enter__(self):
        return self

    def __exit__(self, *a):
        if self.br:
            self.br.close()
            self.br = None

    def browser(self):
        if not self.br:
            self.br = Browser(debug=self.debug)
        return self.br

    def _headers(self, url):
        return {"content-type": "application/json", "accept": "application/json", "locale": "zh-TW",
                "currency": self.currency, "x-ctx-Locale": "zh-TW", "x-ctx-Currency": self.currency,
                "x-ctx-Country": "TW", "cookieOrigin": ORIGIN}

    def _http(self, method, url, body=None, headers=None):
        h = {"User-Agent": self.ua, "Accept-Language": "zh-TW,zh;q=0.9,en;q=0.8", "Origin": ORIGIN,
             "Referer": ORIGIN + "/hotels/"}
        h.update(headers or {})
        if self.st.get("cookies"):
            h["Cookie"] = cookie_header(self.st["cookies"], url, self.currency)
        data = body.encode() if isinstance(body, str) else body
        if self.debug:
            print(f"> {method} {url} {(body or '')[:300]}", file=sys.stderr)
        req = urllib.request.Request(url, data=data, headers=h, method=method)
        try:
            with urllib.request.urlopen(req, timeout=30) as r:
                code, text = r.status, r.read().decode("utf-8", "replace")
        except urllib.error.HTTPError as e:
            code, text = e.code, e.read().decode("utf-8", "replace")
        except OSError as e:
            raise Net(f"{urllib.parse.urlparse(url).netloc}: {e}")
        if self.debug:
            print(f"< {code} {text[:300]}", file=sys.stderr)
        return code, text

    def _pace(self):
        if self._calls:
            time.sleep(PACE)
        self._calls += 1

    def get(self, url):
        self._pace()
        if self.via == "browser":
            return self.browser().fetch("GET", url)
        return self._http("GET", url)

    def soa(self, url, body, session=True, data_key="data"):
        """POST a SOA2 JSON body. Returns the parsed reply."""
        if session and not signed_in(self.st.get("cookies")) and self.via != "browser":
            raise Auth("not signed in - run `trip login` (Trip.com hotel services return an empty "
                       "anti-bot reply without a session; measured)")
        self._pace()
        raw = json.dumps(body, ensure_ascii=False)
        hdr = self._headers(url)
        if self.via == "browser":
            code, text = self.browser().fetch("POST", url, raw, hdr)
        else:
            code, text = self._http("POST", url, raw.encode(), hdr)
        if code in (403, 429, 432) or (code >= 500 and "<" in text[:200]):
            raise Blocked(f"{urllib.parse.urlparse(url).path}: HTTP {code} (bot wall?)")
        try:
            d = json.loads(text)
        except ValueError:
            raise ApiError(f"{url.split('?')[0]}: non-JSON reply (HTTP {code})", {"http": code, "body": text[:300]})
        if code >= 400:
            raise ApiError(f"{url.split('?')[0]}: HTTP {code}", {"http": code, "body": text[:300]})
        rs = d.get("ResponseStatus") or {}
        ext = {(e.get("id") or e.get("Id")): (e.get("value") or e.get("Value")) for e in rs.get("Extension") or []}
        if data_key and data_key not in d and ext.get("ResultId") == "201":
            if self.via == "auto" and not self.br:
                if self.debug:
                    print("note: empty anti-bot reply over HTTP, retrying in a background Edge tab", file=sys.stderr)
                self.via = "browser"
                try:
                    return self.soa(url, body, session, data_key)
                finally:
                    self.via = "auto"
            raise Auth("Trip.com returned an empty anti-bot reply (ResultId 201): the session is missing or "
                       "expired - run `trip login`")
        if rs.get("Ack") not in (None, "Success"):
            raise ApiError(f"{url.split('?')[0]}: {rs.get('Ack')} {rs.get('Errors')}"[:400])
        return d

    def head(self):
        return {"platform": "PC", "cver": "0", "bu": "IBU", "group": "trip", "aid": "", "sid": "", "ouid": "",
                "locale": "zh-TW", "region": "TW", "timezone": "8", "currency": self.currency,
                "pageId": "10320668148", "guid": "", "isSSR": False}

    def account_head(self):
        cid = next((c["value"] for c in self.st.get("cookies") or [] if c["name"] == "GUID"), "")
        return {"cid": cid, "ctok": "", "cver": "1.0", "lang": "01", "sid": "8888", "syscode": "09", "auth": "",
                "xsid": "", "extension": [], "Locale": "zh-TW", "Language": "tw", "Currency": self.currency,
                "ClientID": cid}


# --------------------------------------------------------------- helpers
def parse_date(s):
    try:
        return dt.date.fromisoformat(s)
    except Exception:
        raise Usage(f"bad date {s!r}, expected YYYY-MM-DD")


def stay(args):
    ci, co = parse_date(args.checkin), parse_date(args.checkout)
    if co <= ci:
        raise Usage("--checkout must be after --checkin")
    if args.adults < 1 or args.rooms < 1:
        raise Usage("--adults and --rooms must be >= 1")
    if args.rooms > args.adults:
        raise Usage("--rooms cannot exceed --adults")
    return ci, co, (co - ci).days


def hotel_id(ref):
    ref = str(ref).strip()
    if re.fullmatch(r"\d+", ref):
        return int(ref)
    m = re.search(r"[?&]hotel[Ii][dD]=(\d+)", ref) or re.search(r"hotel-detail-(\d+)", ref)
    if not m:
        raise Usage(f"not a Trip.com hotel id or URL: {ref!r}")
    return int(m.group(1))


def hotel_url(hid, args):
    q = {"hotelId": hid, "checkIn": args.checkin, "checkOut": args.checkout, "adult": args.adults,
         "children": len(args.children), "crn": args.rooms, "curr": args.currency or "TWD", "locale": "zh-TW"}
    if args.children:
        q["ages"] = ",".join(str(a) for a in args.children)
    return ORIGIN + "/hotels/detail/?" + urllib.parse.urlencode(q)


def ms_date(s):
    m = re.search(r"/Date\((-?\d+)([+-]\d{2})(\d{2})\)/", s or "")
    if not m:
        return None
    off = dt.timedelta(hours=int(m.group(2)), minutes=int(m.group(3)) * (1 if m.group(2)[0] == "+" else -1))
    return (dt.datetime.fromtimestamp(int(m.group(1)) / 1000, dt.timezone.utc) + off).date().isoformat()


def flight_payload(html):
    """Concatenate Next.js self.__next_f string chunks."""
    buf = []
    for p in re.findall(r"self\.__next_f\.push\((\[.*?\])\)</script>", html, re.S):
        try:
            a = json.loads(p)
        except ValueError:
            continue
        if len(a) > 1 and isinstance(a[1], str):
            buf.append(a[1])
    return "".join(buf)


def grab(payload, key):
    i = payload.find(f'"{key}":')
    if i < 0:
        return None
    try:
        return json.JSONDecoder().raw_decode(payload[i + len(key) + 3:])[0]
    except ValueError:
        return None


# --------------------------------------------------------------- suggest
def keywords(cl, text):
    d = cl.soa(SOA + "/34951/getHotelKeywords",
               {"queryInfo": {"keyword": text, "actionType": "destination"}, "head": cl.head()}, session=False)
    out = []
    for k in ((d.get("data") or {}).get("mainKeywordList") or {}).get("keywords") or []:
        kw, ctl = k.get("keyword") or {}, k.get("controlInfo") or {}
        ci = kw.get("keywordContentInfo") or {}
        f = (ctl.get("keywordFilterItem") or {}).get("data") or {}
        city = (ctl.get("regionInfo") or {}).get("basicCityModel") or {}
        sub = next((x.get("value") for x in ci.get("displayTexts") or [] if x.get("key") == "SUB_TITLE"), None)
        ftype = f.get("type")
        out.append({"name": ci.get("keyword"), "area": sub, "kind": {"19": "city", "13": "landmark", "11": "station",
                    "31": "hotel"}.get(ftype, ftype), "filter_id": f.get("filterID"), "city_id": city.get("cityId"),
                    "country_id": city.get("countryId"),
                    "_filter": {"filterId": f.get("filterID"), "type": ftype, "value": f.get("value"),
                                "subType": f.get("subType", "")} if f.get("filterID") else None})
    return out


def cmd_suggest(args):
    with Client(args) as cl:
        items = keywords(cl, args.text)[: args.limit]
    pub = [{k: v for k, v in i.items() if not k.startswith("_")} for i in items]
    return emit(ok({"query": args.text, "items": pub}), args.json, lambda: table(
        [[i["filter_id"], i["name"], i["kind"], i["area"], i["city_id"]] for i in pub],
        ["filter_id", "name", "kind", "area", "city_id"]))


def resolve_destination(cl, dest, country_id):
    if re.fullmatch(r"\d+", str(dest)):
        return {"city_id": int(dest), "country_id": country_id or 0, "name": f"city {dest}", "filter": None,
                "kind": "city"}
    items = [i for i in keywords(cl, dest) if i["city_id"]]
    if not items:
        raise ApiError(f"no destination matched {dest!r} (try `trip suggest {dest}`)")
    top = items[0]
    return {"city_id": top["city_id"], "country_id": top["country_id"], "name": f"{top['name']} ({top['area']})" if top["area"] else top["name"],
            "kind": top["kind"], "filter": None if top["kind"] == "city" else top["_filter"],
            "filter_id": top["filter_id"]}


