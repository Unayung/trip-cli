                     f"({money(c['price_per_night'], cl.currency)}/night) {c.get('cancellation') or ''}")
        if out.get("sold_out"):
            L.append("SOLD OUT for these dates/party")
        for rm in out["rooms"]:
            L.append(f"\n[{rm['room_id']}] {rm['name']}  {rm['beds'] or ''}  {rm['size'] or ''}")
            for rt in rm["rates"]:
                L.append(f"  {money(rt['price_total'], cl.currency):>11} total  {money(rt['price_per_night'], cl.currency)}"
                         f"/night  max {rt['max_guests']}  {rt['breakfast'] or '無早餐資訊'}  {rt['cancellation'] or ''}"
                         f"  {rt['payment'] or ''}  left {rt['rooms_left']}{'  +可能額外收費' if rt['extra_charges_possible'] else ''}")
        if out["hidden_rates"]:
            L.append(f"\n({out['hidden_rates']} rate(s) hidden by the site: {'; '.join(out['hidden_reason'] or [])})")
