def parse_rate(skey, s, nights):
    ci = s.get("cancelInfo") or {}
    free_until = next((x.get("localTimeDesc") for x in ci.get("ladderDetailInfo") or []
                       if x.get("ladderType") == "Free"), None)
    pi = s.get("priceInfo") or {}
    bs = s.get("bookingStatusInfo") or {}
    total = s.get("comparingAmount")
    total = total if isinstance(total, (int, float)) and total > 0 else None
    expl = pi.get("priceExplanation") or ""
    meal = (s.get("mealInfo") or {}).get("title")
    return {"rate_id": skey,
            "price_total": total, "price_per_night": round(total / nights) if total else None,
            "unit_price_per_night": pi.get("price"), "currency": pi.get("currency"),
            "price_note": untag(expl.replace("\n", " ")) or None,
            "taxes_included": "含稅" in expl or "總價" in expl,
            "extra_charges_possible": "可能額外收費" in expl,
            "breakfast": meal, "cancellation": ci.get("title"), "free_cancel_until": free_until,
            "payment": (s.get("paymentInfo") or {}).get("paymentTitleNew"),
            "confirmation": (s.get("confirmInfo") or {}).get("title"),
            "max_guests": (s.get("guestCountInfo") or {}).get("guestCount"),
            "rooms_left": bs.get("remainRoomQuantity"),
            "bookable": bool(bs.get("isBooking")) and not bs.get("isFullRoom"),
            "member_or_promo": [p.get("title") for p in (s.get("totalPriceInfo") or {}).get("promotionItems") or []],
            "label": (s.get("titleInfo") or {}).get("title") or None}


def parse_rooms(d, nights):
    data = d.get("data") or {}
    phys, sale = data.get("physicRoomMap") or {}, data.get("saleRoomMap") or {}
    rooms, shown = [], set()
    for r in data.get("roomList") or []:
        p = phys.get(str(r.get("key"))) or {}
        rates = []
        for sub in r.get("subRoomList") or []:
            s = sale.get(sub.get("skey"))
            if s:
                shown.add(sub["skey"])
                rates.append(parse_rate(sub["skey"], s, nights))
        rooms.append({"room_id": r.get("key"), "name": p.get("name"),
                      "beds": untag((p.get("bedInfo") or {}).get("title")) or None,
                      "size": (p.get("areaInfo") or {}).get("title"), "rent": p.get("rent"),
                      "smoking": (p.get("smokeInfo") or {}).get("title"),
                      "window": (p.get("windowInfo") or {}).get("title"), "rates": rates})
    hidden = [k for k in sale if k not in shown]
    reasons = sorted({h for k in hidden for h in ((sale[k].get("guestCountInfo") or {}).get("childHover") or [])})
    bookable = [(rt, rm) for rm in rooms for rt in rm["rates"] if rt["bookable"] and rt["price_total"]]
    cheapest = min(bookable, key=lambda x: x[0]["price_total"]) if bookable else None
    return {"rooms": rooms, "sold_out": bool(data.get("isRoomListSoldOut")),
            "hidden_rates": len(hidden), "hidden_reason": reasons or None,
            "cheapest": None if not cheapest else {"room": cheapest[1]["name"], **cheapest[0]}}


def hotel_static(cl, hid, args):
    code, html = cl.get(hotel_url(hid, args))
    if code >= 400:
        return {"static_error": f"detail page HTTP {code}"}
    pl = flight_payload(html)
    det = grab(pl, "hotelDetailResponse") or {}
    if not det:
        return {"static_error": "detail page carried no hotelDetailResponse"}
    base, pos = det.get("hotelBaseInfo") or {}, det.get("hotelPositionInfo") or {}
    com = (det.get("hotelComment") or {}).get("comment") or {}
    pol = ((det.get("hotelPolicyInfo") or {}).get("checkInAndOut") or {}).get("content") or []
    times = {x.get("title"): x.get("description") for x in pol if x.get("title")}
    amen = []
    for cat in (det.get("hotelFacilityPopV2") or {}).get("hotelFacility") or []:
        for grp in cat.get("categoryList") or []:
            for f in grp.get("list") or []:
                if f.get("facilityDesc") and f["facilityDesc"] not in amen:
                    amen.append(f["facilityDesc"])
    star = base.get("starInfo") or {}
    return {"name": (base.get("nameInfo") or {}).get("name"), "stars": star.get("level"),
            "stars_kind": star.get("type"), "address": pos.get("address"), "area": pos.get("zoneName"),
            "transport": (pos.get("trafficInfo") or {}).get("trafficDesc"),
            "rating": num(com.get("score")), "reviews": com.get("totalComment"),
            "checkin_time": times.get("入住："), "checkout_time": times.get("退房時間："),
            "amenities": amen[:40], "saved": base.get("isFavoriteHotel"),
            "logged_in": (det.get("authInfo") or {}).get("isLogin")}


