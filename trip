def account_info(cl):
    d = cl.soa(SOA + "/27024/ssoIsLoginAndGetAccountInfo", {"head": cl.head()}, data_key=None)
    if d.get("isLogin") != "T":
        raise Auth(f"session rejected by Trip.com ({d.get('message') or 'isLogin != T'}) - run `trip login`")
    out = {"logged_in": True, "email": d.get("maskedEmail"), "linked": d.get("thirdTypes"), "message": d.get("message")}
    try:
        u = cl.soa(SOA + "/27024/getUserInfo", {"locale": "zh-TW", "accessCode": "IBUPCAUTEHNTICATE",
                                                 "head": cl.account_head()}, data_key=None)
        g = u.get("vipGrade")
        ui = u.get("thisUserInfo") or {}
        out.update(vip_grade=g, tier=VIP.get(g, f"grade {g} (label unverified)" if g is not None else None),
                   nickname=ui.get("nickName") or None)
    except (ApiError, Auth) as e:
        out["tier_error"] = str(e)
    return out


def login_from_browser(args):
    cookies, ua = edge_cookies()
    if signed_in(cookies):
        return cookies, ua
    br = Browser(ORIGIN + "/account/signin?locale=zh-TW", debug=args.debug)
    try:
        print(f"Sign in to Trip.com in the new background tab of the browser on {CDP} (switch to it yourself; "
              f"this CLI never types passwords). Waiting up to {args.wait}s...", file=sys.stderr)
        t0 = time.time()
        while time.time() - t0 < args.wait:
            time.sleep(4)
            cookies, ua = edge_cookies()
            if signed_in(cookies):
                return cookies, ua
        raise Auth(f"not signed in after {args.wait}s; run `trip login` again")
    finally:
        br.close()


def _clipboard():
    for cmd in (["wl-paste", "-n"], ["pbpaste"], ["xclip", "-o", "-selection", "clipboard"]):
        try:
            r = subprocess.run(cmd, capture_output=True, text=True, timeout=5)
        except (FileNotFoundError, subprocess.TimeoutExpired):
            continue
        if r.returncode == 0 and r.stdout.strip():
            return r.stdout.strip()
    raise Auth("clipboard is empty or no clipboard tool (wl-paste / pbpaste / xclip)")


def _read_cookie_tty():
    import termios
    fd = sys.stdin.fileno()
    old, new = termios.tcgetattr(fd), termios.tcgetattr(fd)
    new[3] &= ~(termios.ICANON | termios.ECHO)
    new[6][termios.VMIN], new[6][termios.VTIME] = 1, 0
    print("paste the Cookie header, then press Enter (input hidden):", file=sys.stderr)
    buf = bytearray()
    try:
        termios.tcsetattr(fd, termios.TCSANOW, new)
        while True:
            ch = os.read(fd, 65536)
            if not ch:
                break
            if b"\x03" in ch:
                raise KeyboardInterrupt
            buf += ch
            if b"\r" in ch or b"\n" in ch:
                break
    finally:
        termios.tcsetattr(fd, termios.TCSANOW, old)
        print(file=sys.stderr)
    return buf.decode("utf-8", "replace").splitlines()[0] if buf else ""


def cmd_login(args):
    if args.from_clipboard or args.cookie_stdin:
        raw = _clipboard() if args.from_clipboard else (_read_cookie_tty() if sys.stdin.isatty() else sys.stdin.read())
        cookies, ua = header_to_cookies(clean_cookie(raw)), os.environ.get("TRIP_UA") or DEFAULT_UA
        src = "clipboard" if args.from_clipboard else "stdin"
    else:
        cookies, ua = login_from_browser(args)
        src = f"browser {CDP}"
    st = {"cookies": cookies, "ua": ua}
    with Client(argparse.Namespace(via="http", debug=args.debug, currency=args.currency), st) as cl:
        who = account_info(cl)
    st2 = load_state()
    st2.pop("source", None)
    if st2.get("keyring_parts"):
        keyring_clear(st2["keyring_parts"])
    for k in ("keyring_parts", "keyring_error"):
        st2.pop(k, None)
    st2.update(cookies=cookies, ua=ua, cookie_in_keyring=bool(args.keyring), user=who,
               logged_in_at=int(time.time()), login_source=src)
    if args.keyring:
        st2["keyring_parts"] = keyring_save(cookies)
        if keyring_load(st2["keyring_parts"]) != cookies:
            raise Auth("keyring did not return the session it was given; use the state file")
    save_state(st2)
    out = {"user": who, "stored": "keyring" if args.keyring else STATE_FILE, "cookies": len(cookies)}
    return emit(ok(out), args.json, lambda: f"signed in as {who.get('email')} ({who.get('tier') or 'tier ?'}); "
                f"session ({len(cookies)} cookies) saved to {out['stored']}")


