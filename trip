def cmd_doctor(args):
    checks = []
    st = load_state()
    checks.append(["state", "ok" if os.path.exists(STATE_FILE) else "-", STATE_FILE])
    try:
        ver = _http_json("/json/version")
        checks.append(["cdp", "ok", f"{CDP} {ver.get('Browser')} (needed for login/saved add-rm/--via browser)"])
    except Net as e:
        checks.append(["cdp", "-", str(e)])
    with Client(argparse.Namespace(via="http", debug=args.debug, currency=args.currency), st) as cl:
        try:
            n = len(keywords(cl, "東京"))
            checks.append(["typeahead (http)", "ok" if n else "FAIL", f"getHotelKeywords 東京: {n} match(es)"])
        except (Net, ApiError, Auth) as e:
            checks.append(["typeahead (http)", "FAIL", str(e)])
        if signed_in(st.get("cookies")):
            try:
                who = account_info(cl)
                checks.append(["login", "ok", f"{who.get('email')} {who.get('tier') or ''} via {st.get('source')}"])
            except (Net, ApiError, Auth) as e:
                checks.append(["login", "FAIL", str(e)])
        else:
            checks.append(["login", "FAIL", "no session: search/hotel/price need `trip login` (measured: empty "
                                             "anti-bot replies without one)"])
    bad = any(c[1] == "FAIL" for c in checks)
    payload = err("doctor found problems", EX_AUTH if checks[-1][1] == "FAIL" else EX_NET, checks=checks) \
        if bad else ok({"checks": checks})
    return emit(payload, args.json, lambda: table(checks, ["check", "state", "detail"]))


